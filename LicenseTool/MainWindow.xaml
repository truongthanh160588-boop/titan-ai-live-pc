<Window x:Class="LicenseTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Titan AI Live - License Generator"
        Height="420"
        Width="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F1A">
    <Border Margin="14" BorderBrush="#223754" BorderThickness="1" CornerRadius="8" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Nhap Hardware ID de sinh Activation Code."
                       Foreground="#EAF2FF"
                       FontSize="20"
                       FontWeight="SemiBold"/>

            <TextBlock Grid.Row="1"
                       Margin="0,16,0,6"
                       Text="Hardware ID"
                       Foreground="#BED0E6"
                       FontSize="15"/>
            <TextBox x:Name="HardwareIdTextBox"
                     Grid.Row="2"
                     Height="36"
                     FontSize="14"
                     Padding="10,6"
                     Background="#101B30"
                     Foreground="#F7FAFF"
                     BorderBrush="#2F4A70"
                     BorderThickness="1"/>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="Activation Code" Foreground="#BED0E6" FontSize="15" Margin="0,0,0,6"/>
                <TextBox x:Name="ActivationCodeTextBox"
                         Height="70"
                         FontSize="13"
                         Padding="10,8"
                         IsReadOnly="True"
                         TextWrapping="WrapWithOverflow"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="#1A2941"
                         Foreground="#F7FAFF"
                         BorderBrush="#2F4A70"
                         BorderThickness="1"/>
            </StackPanel>

            <DockPanel Grid.Row="4" Margin="0,18,0,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"
                           Foreground="#7FD6A2"/>
                <Button Content="Thoat"
                        Width="110"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="Close_Click"/>
                <Button Content="Generate"
                        Width="130"
                        Height="36"
                        Background="#12C798"
                        Foreground="White"
                        BorderBrush="#0FAE84"
                        Click="Generate_Click"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
