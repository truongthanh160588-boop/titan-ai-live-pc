<Window x:Class="TitanAILivePC.HelpInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giới thiệu - Titan AI Live PC"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#111111">
    <Border Margin="12" Padding="14" CornerRadius="10" Background="#1F1F1F" BorderBrush="#2F2F2F" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <Image Source="/Assets/titanailive.ico" Width="56" Height="56" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                <StackPanel>
                    <TextBlock Text="Titan AI Live PC" Foreground="#FFFFFF" FontSize="38" FontWeight="Bold"/>
                    <TextBlock Text="Made in Vietnam" Foreground="#D0D0D0" FontSize="16" Margin="0,2,0,0"/>
                    <TextBlock Text="Version 1.0" Foreground="#B8B8B8" FontSize="15"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Height="1" Margin="0,14,0,14" Background="#3A3A3A"/>

            <TextBlock Grid.Row="2"
                       Text="PHẦN MỀM ĐÃ KÍCH HOẠT VĨNH VIỄN"
                       Foreground="#28D66C"
                       FontSize="30"
                       FontWeight="Bold"/>

            <ScrollViewer Grid.Row="3"
                          Margin="0,14,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Giải pháp hỗ trợ livestream thông minh dành cho bán hàng và trình diễn chuyên nghiệp."
                               Foreground="#FFFFFF"
                               FontSize="20"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="✔ Tự động đọc bình luận livestream"
                               Foreground="#E7E7E7"
                               FontSize="19"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="✔ AI hỗ trợ phản hồi khách hàng realtime"
                               Foreground="#E7E7E7"
                               FontSize="19"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="✔ Hỗ trợ voice tiếng Việt"
                               Foreground="#E7E7E7"
                               FontSize="19"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="✔ Tăng tốc tương tác khi livestream"
                               Foreground="#E7E7E7"
                               FontSize="19"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="Phù hợp cho:"
                               Foreground="#8DD5FF"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="• Livestream bán hàng"
                               Foreground="#E7E7E7"
                               FontSize="19"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="• Âm thanh – điện tử"
                               Foreground="#E7E7E7"
                               FontSize="19"
                               Margin="0,3,0,0"/>
                    <TextBlock Text="• Review sản phẩm"
                               Foreground="#E7E7E7"
                               FontSize="19"
                               Margin="0,3,0,0"/>
                    <TextBlock Text="• Talkshow – sự kiện trực tiếp"
                               Foreground="#E7E7E7"
                               FontSize="19"
                               Margin="0,3,0,0"/>

                    <TextBlock Text="📞 Liên hệ hỗ trợ &amp; phát triển: 0974 70 4444"
                               Foreground="#FFFFFF"
                               FontSize="20"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="Phát triển phần mềm bởi ToolsAnalyzer – Developed by Truong Thanh"
                               Foreground="#8DD5FF"
                               FontSize="18"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,16,0,0">
                <Button Content="Zalo" Width="125" Height="36" Margin="0,0,10,0" Background="#2E7EF7" Foreground="#FFFFFF" BorderBrush="#2E7EF7" Click="Zalo_Click"/>
                <Button Content="WhatsApp" Width="150" Height="36" Margin="0,0,10,0" Background="#1FCB5B" Foreground="#FFFFFF" BorderBrush="#1FCB5B" Click="WhatsApp_Click"/>
                <Button Content="Facebook" Width="145" Height="36" Margin="0,0,10,0" Background="#287AE6" Foreground="#FFFFFF" BorderBrush="#287AE6" Click="Facebook_Click"/>
                <Button Content="Đóng" Width="120" Height="36" Background="#5A5A5A" Foreground="#FFFFFF" BorderBrush="#5A5A5A" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
