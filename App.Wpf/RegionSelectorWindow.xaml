<Window x:Class="TitanAILivePC.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Chat Region"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Canvas x:Name="RootCanvas"
            Background="#01000000"
            MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
            MouseMove="RootCanvas_MouseMove"
            MouseLeftButtonUp="RootCanvas_MouseLeftButtonUp">
        <Rectangle x:Name="SelectionRect"
                   Stroke="#FFC84A"
                   StrokeThickness="2"
                   Fill="#332B6DA8"
                   Visibility="Collapsed"/>
        <Border Canvas.Left="20" Canvas.Top="20" Background="#CC111822" BorderBrush="#4EA3FF" BorderThickness="1" CornerRadius="6" Padding="10" IsHitTestVisible="False">
            <TextBlock Text="Drag to select livestream chat region. Press ESC to cancel." Foreground="#EAF2FF"/>
        </Border>
    </Canvas>
</Window>
