<Window x:Class="TitanAILivePC.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giới thiệu - Titan AI Live PC"
        Width="700"
        Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0A0F16">
    <Border Margin="16" Padding="16" CornerRadius="10" BorderBrush="#324E72" BorderThickness="1" Background="#0F1622">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="True">
                <Image DockPanel.Dock="Left" Source="/Assets/titanailive.ico" Width="52" Height="52" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Titan AI Live PC" Foreground="#F5C542" FontSize="30" FontWeight="Bold"/>
                    <TextBlock x:Name="VersionText" Foreground="#9FBCD8" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Grid.Row="1"
                       Margin="0,16,0,0"
                       Text="Nền tảng livestream studio AI cho bình luận thời gian thực, phản hồi tự động và điều phối giọng đọc chuyên nghiệp."
                       TextWrapping="Wrap"
                       Foreground="#DDE8F6"
                       FontSize="14"/>

            <Border Grid.Row="2" Margin="0,14,0,0" Height="1" Background="#2D4565"/>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="THÔNG TIN SẢN PHẨM" Foreground="#7EC5FF" FontWeight="Bold"/>
                <TextBlock Text="• Broadcast Engine: OCR + AI Reply + TTS + OBS Program Control" Foreground="#D4E3F5" Margin="0,8,0,0"/>
                <TextBlock Text="• Chế độ Live Studio: ưu tiên vận hành nhanh, ổn định và rõ trạng thái" Foreground="#D4E3F5" Margin="0,4,0,0"/>
                <TextBlock Text="• Chế độ Engineer: đầy đủ debug/diagnostics cho kỹ thuật" Foreground="#D4E3F5" Margin="0,4,0,0"/>
                <TextBlock Text="• License: xác thực chữ ký số RSA theo từng Hardware ID" Foreground="#D4E3F5" Margin="0,4,0,0"/>

                <TextBlock Text="HỖ TRỢ" Foreground="#7EC5FF" FontWeight="Bold" Margin="0,16,0,0"/>
                <TextBlock Text="Email: support@titanailive.local" Foreground="#D4E3F5" Margin="0,8,0,0"/>
                <TextBlock Text="Website: titanailive.local" Foreground="#D4E3F5" Margin="0,4,0,0"/>
            </StackPanel>

            <DockPanel Grid.Row="4" Margin="0,16,0,0">
                <TextBlock Text="© Titan AI Live Studio. All rights reserved."
                           Foreground="#8FA7C5"
                           VerticalAlignment="Center"/>
                <Button Content="Đóng" Width="110" Height="34" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="Close_Click"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
