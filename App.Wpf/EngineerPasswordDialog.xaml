<Window x:Class="TitanAILivePC.EngineerPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Engineer mode"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#090A0D">
    <Border Padding="18" BorderBrush="#324158" BorderThickness="1" CornerRadius="8" Margin="10">
        <StackPanel>
            <TextBlock Text="Enter engineer password" Foreground="#F5C542" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
            <PasswordBox x:Name="PasswordInputBox"
                         Height="30"
                         Background="#0D121A"
                         Foreground="#E5EBF6"
                         BorderBrush="#345173"
                         BorderThickness="1"
                         Padding="8,4"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Width="88" Height="30" Margin="0,0,8,0" Click="Cancel_Click"
                        Background="#1A2434" Foreground="#E6EDF9" BorderBrush="#4A658C"/>
                <Button Content="OK" Width="88" Height="30" Click="Ok_Click"
                        Background="#243045" Foreground="#E6EDF9" BorderBrush="#4A658C"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
