<Window x:Class="TitanAILivePC.PriceCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảng giá nhanh - Titan AI Live PC"
        Width="980"
        Height="620"
        MinWidth="860"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#090D14">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="CHỈNH BẢNG GIÁ NHANH"
                   Foreground="#F5C542"
                   FontSize="20"
                   FontWeight="Bold"/>

        <DataGrid x:Name="PriceGrid"
                  Grid.Row="1"
                  Margin="0,10,0,10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Background="#0D121A"
                  Foreground="#E5EBF6"
                  BorderBrush="#345173"
                  BorderThickness="1"
                  RowBackground="#0D121A"
                  AlternatingRowBackground="#111A28"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#24384F"
                  VerticalGridLinesBrush="#24384F">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding NormalizedKey}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Giá" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2">
            <TextBlock x:Name="StatusText"
                       Foreground="#8FAFCC"
                       VerticalAlignment="Center"
                       Text="Sửa cột Giá, bấm Lưu hoặc đóng cửa sổ để tự lưu."/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Lưu ngay" Width="110" Height="32" Margin="0,0,8,0" Click="Save_Click"/>
                <Button Content="Đóng" Width="90" Height="32" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
