<Window x:Class="TitanAILivePC.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Titan AI Live Activation"
        Width="760"
        Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0A0F16">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Kích hoạt Titan AI Live PC" Foreground="#F5C542" FontSize="22" FontWeight="Bold"/>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="Hardware ID" Foreground="#8FB0D5"/>
            <DockPanel Margin="0,6,0,0">
                <TextBox x:Name="HardwareIdText" IsReadOnly="True" Height="32" Background="#111926" Foreground="#EAF0FA" BorderBrush="#33506F" BorderThickness="1" Padding="10,6"/>
                <Button Content="Copy" Width="72" Margin="8,0,0,0" Click="CopyHardwareId_Click"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Activation Code" Foreground="#8FB0D5"/>
            <TextBox x:Name="ActivationCodeText"
                     Margin="0,6,0,0"
                     Height="98"
                     AcceptsReturn="True"
                     TextWrapping="WrapWithOverflow"
                     VerticalScrollBarVisibility="Auto"
                     Background="#111926"
                     Foreground="#EAF0FA"
                     BorderBrush="#33506F"
                     BorderThickness="1"
                     Padding="10,8"/>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="#FF8E8E" TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
            <Button Content="Thoát" Width="96" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Kích hoạt" Width="120" Background="#1E5EFF" Foreground="White" Click="Activate_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
