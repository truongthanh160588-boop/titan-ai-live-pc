                        </Border>
                        <Border Style="{StaticResource LiveProStatusChipStyle}" Margin="6,0,0,0">
                            <TextBlock Text="{Binding LiveHeaderReadyCaption}" Foreground="{Binding LiveHeaderReadyBrush}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Border>
                    </UniformGrid>
                    <ProgressBar Grid.Row="2" Style="{StaticResource LiveStudioProgramMeterStyle}"
                                 Margin="0,12,0,0"
                                 Value="{Binding LiveStudioAudioEnergy, Mode=OneWay}"
                                 Visibility="{Binding IsLiveBroadcastEffectsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                 ToolTip="Program audio energy (TTS activity)"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="276"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="232"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource LiveProSurfaceStyle}" Margin="0,0,12,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="PROGRAM · OBS" Style="{StaticResource LiveProSectionTitleStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ObsHost, UpdateSourceTrigger=PropertyChanged}" Height="28" Style="{StaticResource DarkTextBoxStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding ObsPort, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="8,0,0,0" Style="{StaticResource DarkTextBoxStyle}"/>
                            </Grid>
                            <PasswordBox x:Name="LiveObsPasswordBox" PasswordChanged="LiveObsPasswordBox_PasswordChanged" Height="28" Margin="0,8,0,0" Style="{StaticResource DarkPasswordBoxStyle}"/>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button Content="CONNECT OBS" Command="{Binding ConnectObsCommand}" Style="{StaticResource LiveSetupConnectObsButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="DISCONNECT" Command="{Binding DisconnectObsCommand}" Style="{StaticResource LiveProDangerButtonStyle}" Margin="6,0,0,0"/>
                            </UniformGrid>
                            <TextBlock Text="{Binding LiveObsConnectionHint}" Foreground="#8FB0D5" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="CHAT CAPTURE" Style="{StaticResource LiveProSectionTitleStyle}" Margin="0,14,0,0"/>
                            <Button Content="SELECT CHAT REGION" Command="{Binding SelectChatRegionCommand}" Style="{StaticResource LiveSetupSelectChatRegionButtonStyle}"/>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button Content="START OCR" Command="{Binding StartOcrCommand}" Style="{StaticResource LiveSetupStartOcrButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="STOP OCR" Command="{Binding StopOcrCommand}" Style="{StaticResource LiveProDangerButtonStyle}" Margin="6,0,0,0"/>
                            </UniformGrid>
                            <CheckBox Content="AUTO REPLY" IsChecked="{Binding AutoReplyEnabled}" Style="{StaticResource LiveProAutoCheckBoxStyle}" Margin="0,10,0,0"/>
                            <CheckBox Content="AUTO TTS" IsChecked="{Binding AutoTtsEnabled}" Style="{StaticResource LiveProAutoCheckBoxStyle}"/>
                            <CheckBox Content="AUTO SPEAK LIVE REPLY" IsChecked="{Binding AutoSpeakLiveReply}" Style="{StaticResource LiveProAutoCheckBoxStyle}"/>

                            <TextBlock Text="VOICE BUS" Style="{StaticResource LiveProSectionTitleStyle}" Margin="0,14,0,0"/>
                            <ComboBox ItemsSource="{Binding VoiceOptions}" SelectedItem="{Binding PendingVoiceName}" Height="30"/>
                            <Button Content="ÁP DỤNG GIỌNG" Command="{Binding ApplyVoiceSelectionCommand}" Style="{StaticResource LiveProButtonStyle}"/>
                            <Button Content="SPEAK REPLY" Command="{Binding SpeakReplyCommand}" Style="{StaticResource LiveProSpeakingButtonStyle}" Tag="{Binding IsAiSpeaking}"/>
                            <CheckBox Content="MUTE OUTPUT" IsChecked="{Binding IsMuted}" Foreground="#C8D8EC" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2.35*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource LiveProSurfaceStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="LIVE FEED" Foreground="#F5C542" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Grid.Row="1" Text="On-air comment lane · TITAN DSP ENGINE" Foreground="#6E8AAF" FontSize="11" Margin="0,4,0,12"/>
                            <TextBox Grid.Row="2" Text="{Binding CommentInput, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource DarkTextBoxStyle}" FontSize="13"/>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,12">
                                <Button Content="ADD COMMENT" Command="{Binding AddCommentCommand}" Style="{StaticResource LiveProButtonStyle}" Width="136" Margin="0,0,8,0"/>
                                <Button Content="GEN AI REPLY" Command="{Binding GenerateReplyCommand}" Style="{StaticResource LiveProButtonStyle}" Width="136"/>
                            </StackPanel>
                            <ListView x:Name="LiveModeCommentsList"
                                      Grid.Row="4"
                                      Margin="0,0,0,0"
                                      ItemsSource="{Binding Comments}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LiveProCommentRowStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeDisplay}" Foreground="#556C85" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Top"/>
                                                    <TextBlock Text="{Binding UserName}" Foreground="#6FD6E8" FontSize="14" FontWeight="SemiBold"/>
                                                </DockPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding CommentText}" Foreground="#F4F7FB" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource LiveProAiEnergyWrapStyle}">
                        <Border Style="{StaticResource LiveProAiPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel LastChildFill="True">
                                    <Image DockPanel.Dock="Left" Source="/Assets/titanailive.ico" Width="36" Height="36" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="TITAN AI" Foreground="#F5C542" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding LiveAiRoleHeadline}" Foreground="#8FAFCC" FontSize="10.5" Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding LiveAiStateText}" Foreground="{Binding LiveAiStateBrush}" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Text="{Binding LiveProgramOutputLine}" FontSize="10.5" FontWeight="Bold" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#6E8AAF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLiveProgramOutputLive}" Value="True">
                                                    <Setter Property="Foreground" Value="#67D4EA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Grid.Row="2" Height="1" Margin="0,10,0,8" Background="#58B8E8" Opacity="0.35"
                                        Visibility="{Binding IsLiveAiEnergyPulseForChrome, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Grid.Row="3" Text="{Binding LatestCommentPreview}" Foreground="#9BB4D4" FontSize="11" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                                <ItemsControl Grid.Row="4" ItemsSource="{Binding LiveSpeakingWaveBars}" Height="22" Margin="0,0,0,10" Opacity="0.88"
                                              Visibility="{Binding IsLiveAiSpeakingWaveformForChrome, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="3" Height="{Binding}" Margin="1,0" Background="#5CB9E8" VerticalAlignment="Bottom" CornerRadius="2" Opacity="0.92"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Grid.Row="5" Text="{Binding CurrentReply}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         Style="{StaticResource DarkTextBoxStyle}" FontSize="14" Background="#080C12" BorderBrush="#31455F" Padding="12,10" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource LiveProSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="OVERLAY · PROGRAM" Style="{StaticResource LiveProSectionTitleStyle}"/>
                        <Border Background="#0A1018" BorderBrush="#355070" BorderThickness="1" CornerRadius="10" Padding="10,8">
                            <TextBlock Text="{Binding LiveOverlayHeadline}" Foreground="#CFE8FF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="OVERLAY BRAND / TÊN SẢN PHẨM" Foreground="#8CA4C5" FontSize="10" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding OverlayBrandName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 Margin="0,4,0,0"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 ToolTip="Ví dụ: LIVE MÁY XAY CẦM TAY"/>
                        <TextBlock Text="FONT PRESET" Foreground="#8CA4C5" FontSize="10" Margin="0,6,0,0"/>
                        <ComboBox ItemsSource="{Binding OverlayBrandFontPresetOptions}"
                                  SelectedItem="{Binding OverlayBrandFontPreset}"
                                  ItemContainerStyle="{StaticResource LiveDarkComboBoxItemStyle}"
                                  Style="{StaticResource LiveDarkComboBoxStyle}"
                                  Height="28"
                                  Margin="0,4,0,0"
                                  />
                        <Button Content="START OVERLAY" Command="{Binding StartOverlayServerCommand}" Style="{StaticResource LiveSetupStartOverlayButtonStyle}"/>
                        <UniformGrid Columns="2" Margin="0,4,0,0">
                            <Button Content="SHOW" Command="{Binding ShowOverlaySourceCommand}" Style="{StaticResource LiveSetupShowOverlayButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="HIDE" Command="{Binding HideOverlaySourceCommand}" Style="{StaticResource LiveProDangerButtonStyle}" Margin="5,0,0,0"/>
                        </UniformGrid>
                        <Button Content="PUSH AI REPLY" Command="{Binding PushReplyToObsTextCommand}" Style="{StaticResource LiveProButtonStyle}"/>
                        <Button Content="STOP OVERLAY" Command="{Binding StopOverlayServerCommand}" Style="{StaticResource LiveProDangerButtonStyle}" Opacity="0.9"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Panel.ZIndex="1" Style="{StaticResource LiveProFooterBarStyle}" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BroadcastFooterSmartLine}" Foreground="#8FAFCC" FontSize="11" FontWeight="SemiBold" Margin="0,0,22,0"/>
                    <TextBlock Text="{Binding LiveFooterCpuCaption}" Foreground="{Binding LiveFooterCpuBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding LiveFooterRamCaption}" Foreground="{Binding LiveFooterRamBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding LiveFooterOcrCaption}" Foreground="{Binding LiveFooterOcrBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding LiveFooterTtsCaption}" Foreground="{Binding LiveFooterTtsBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding LiveFooterVoiceRouteCaption}" Foreground="{Binding LiveFooterVoiceRouteBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding LiveFooterObsCaption}" Foreground="{Binding LiveFooterObsBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding LiveFooterOverlayCaption}" Foreground="{Binding LiveFooterOverlayBrush}" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="40"
                    Background="#CC07090E"
                    Visibility="{Binding ShowLiveStartupOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="TITAN AI LIVE PC" Foreground="#F5C542" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="INITIALIZING BROADCAST SYSTEM..." Foreground="#85A6CC" FontSize="12" FontWeight="SemiBold"
                               Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
