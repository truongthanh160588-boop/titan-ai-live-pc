                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="4" Style="{StaticResource ModuleCardStyle}"
                        Visibility="{Binding IsEngineerMode, Converter={StaticResource BoolToVisibilityConverter}}">
