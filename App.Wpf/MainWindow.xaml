                                    </Border.Width>
                                </Border>
                                <Canvas>
                                    <Border Width="2" Height="10" Background="#E9FFF0" CornerRadius="1">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource MeterValueToPixelConverter}" ConverterParameter="left">
                                                <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                                <Binding Path="PeakHoldRight"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                    </Border>
                                </Canvas>
