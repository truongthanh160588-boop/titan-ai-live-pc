<Window x:Class="TitanAILivePC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:core="clr-namespace:TitanAILivePC.Core"
        xmlns:controls="clr-namespace:TitanAILivePC.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TITAN AI LIVE SYSTEM"
        Icon="/Assets/titanailive.ico"
        Width="1600"
        Height="900"
        MinWidth="1280"
        MinHeight="720"
        Background="#090A0D">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ApproveAndSpeakCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApproveAndPushObsCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding IgnorePendingCommand}"/>
        <KeyBinding Key="D" Modifiers="Control+Shift" Command="{Binding ToggleEngineerModeCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <core:MeterValueToPixelConverter x:Key="MeterValueToPixelConverter"/>
        <core:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="ModuleCardStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#151A22" Offset="0"/>
                        <GradientStop Color="#10151D" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#324158"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.26" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModuleTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5C542"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="HardwareButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#E6EDF9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="BorderBrush" Value="#4A658C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#243045" Offset="0"/>
                        <GradientStop Color="#1A2434" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F5C542"/>
                                <Setter TargetName="Root" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#F5C542" Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0D121A"/>
            <Setter Property="Foreground" Value="#E5EBF6"/>
            <Setter Property="BorderBrush" Value="#345173"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="DarkPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0D121A"/>
            <Setter Property="Foreground" Value="#E5EBF6"/>
            <Setter Property="BorderBrush" Value="#345173"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="LiveDarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0D121A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#345173"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="8,2,4,2"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="#101A2A"
                                                  BorderBrush="#345173"
                                                  BorderThickness="1,0,0,0">
                                        <Path HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Fill="#FFFFFF"
                                              Data="M 0 0 L 4 4 L 8 0 Z"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,2,0,0"
                                        Background="#0D121A"
                                        BorderBrush="#345173"
                                        BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True" MaxHeight="220">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#5B91C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0D121A"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#0D121A"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E2F49"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                <Style TargetType="TextBox">
                    <Setter Property="Background" Value="#0D121A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#0D121A"/>
                    <Setter Property="CaretBrush" Value="#FFFFFF"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="LiveDarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0D121A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1E2F49"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#27425F"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#151D29"/>
            <Setter Property="BorderBrush" Value="#325071"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="InteractiveStatusToggleStyle" TargetType="primitives:ToggleButton">
            <Setter Property="Foreground" Value="#E6EDF9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ToggleButton">
                        <Border x:Name="Root" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#9ED1FF" Opacity="0.42"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipToggleStyle" TargetType="primitives:ToggleButton">
            <Setter Property="Foreground" Value="#7FC8FF"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#151D29"/>
            <Setter Property="BorderBrush" Value="#325071"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ToggleButton">
                        <Border x:Name="ChipRoot" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipRoot" Property="BorderBrush" Value="#6FB9FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#F5C542"/>
                                <Setter TargetName="ChipRoot" Property="Background" Value="#1D2D44"/>
                                <Setter TargetName="ChipRoot" Property="BorderBrush" Value="#F5C542"/>
                                <Setter TargetName="ChipRoot" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#F5C542" Opacity="0.52"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiActiveChipPulseStyle" TargetType="primitives:ToggleButton" BasedOn="{StaticResource ChipToggleStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAiActiveChipPulseActive}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="AiActiveChipPulseStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.62" Duration="0:0:1.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="AiActiveChipPulseStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PendingApprovalPanelStyle" TargetType="Border" BasedOn="{StaticResource ModuleCardStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPendingAlertActive}" Value="True">
                    <Setter Property="BorderBrush" Value="#F5C542"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PendingPanelPulseStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.72" Duration="0:0:0.45"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PendingPanelPulseStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VoiceLiveIndicatorStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A202A"/>
            <Setter Property="BorderBrush" Value="#4A5B75"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVoiceLiveIndicatorActive}" Value="True">
                    <Setter Property="Background" Value="#1E3A2A"/>
                    <Setter Property="BorderBrush" Value="#73D08B"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="VoiceLivePulseStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.68" Duration="0:0:0.55"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="VoiceLivePulseStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Live Mode PRO (flat surfaces, light accent — engineer layout unchanged) -->
        <Style x:Key="LiveProSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8C76A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LiveProSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1118"/>
            <Setter Property="BorderBrush" Value="#2A3D56"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="LiveProHeaderBarStyle" TargetType="Border">
            <Setter Property="Background" Value="#0A0E14"/>
            <Setter Property="BorderBrush" Value="#3D5F78"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.22" Color="#4FA3FF"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiveProFooterBarStyle" TargetType="Border">
            <Setter Property="Background" Value="#07090E"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="BorderBrush" Value="#283548"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="LiveProStatusChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#101722"/>
            <Setter Property="BorderBrush" Value="#31455F"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <SolidColorBrush x:Key="TitanCyanBrush" Color="#6FD6E8"/>
        <SolidColorBrush x:Key="TitanActiveBrush" Color="#1C3D4F"/>
        <SolidColorBrush x:Key="TitanDangerBrush" Color="#5A262C"/>

        <Style x:Key="LiveProButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#EAF0FA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Background" Value="#141B26"/>
            <Setter Property="BorderBrush" Value="#3A5572"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LiveBtnRoot" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LiveBtnRoot" Property="BorderBrush" Value="#6FD6E8"/>
                                <Setter TargetName="LiveBtnRoot" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#6FD6E8" Opacity="0.38"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LiveBtnRoot" Property="Background" Value="#101821"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LiveBtnRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiveProToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource LiveProButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LiveToggleRoot" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LiveToggleRoot" Property="BorderBrush" Value="{StaticResource TitanCyanBrush}"/>
                                <Setter TargetName="LiveToggleRoot" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#6FD6E8" Opacity="0.28"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LiveToggleRoot" Property="Background" Value="#101821"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter Property="Foreground" Value="#F3FBFF"/>
                                <Setter TargetName="LiveToggleRoot" Property="Background" Value="{StaticResource TitanActiveBrush}"/>
                                <Setter TargetName="LiveToggleRoot" Property="BorderBrush" Value="{StaticResource TitanCyanBrush}"/>
                                <Setter TargetName="LiveToggleRoot" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#6FD6E8" Opacity="0.34"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LiveToggleRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiveProDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource LiveProButtonStyle}">
            <Setter Property="Background" Value="#23181B"/>
            <Setter Property="BorderBrush" Value="#6F4A54"/>
            <Setter Property="Foreground" Value="#EFDCE0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LiveDangerRoot" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LiveDangerRoot" Property="BorderBrush" Value="#8D5B67"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LiveDangerRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiveProSpeakingButtonStyle" TargetType="Button" BasedOn="{StaticResource LiveProToggleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="LiveSpeakingPulseStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.86" Duration="0:0:0.85"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="LiveSpeakingPulseStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveProAutoCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C8D8EC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TitanCyanBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#6FD6E8" Opacity="0.28"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveSetupBlinkButtonStyle" TargetType="Button" BasedOn="{StaticResource LiveProButtonStyle}">
            <Setter Property="Foreground" Value="#F4FAFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SetupRoot" CornerRadius="10" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Background>
                                <SolidColorBrush x:Name="SetupBgBrush" Color="#141B26"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="SetupBorderBrush" Color="#3A5572"/>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SetupRoot" Property="BorderBrush" Value="#6FD6E8"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Completed">
                                <Setter TargetName="SetupRoot" Property="Background" Value="#1E5EFF"/>
                                <Setter TargetName="SetupRoot" Property="BorderBrush" Value="#4DA3FF"/>
                                <Setter TargetName="SetupRoot" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#4DA3FF" Opacity="0.34"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="Tag" Value="Pending">
                                <Setter TargetName="SetupRoot" Property="Background" Value="#1E5EFF"/>
                                <Setter TargetName="SetupRoot" Property="BorderBrush" Value="#4DA3FF"/>
                                <Setter TargetName="SetupRoot" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#4DA3FF" Opacity="0.46"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="Tag" Value="Pending">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="SetupBluePulseStoryboard">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <ColorAnimation Storyboard.TargetName="SetupRoot"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            From="#1E5EFF"
                                                            To="#4DA3FF"
                                                            Duration="0:0:0.8"/>
                                            <ColorAnimation Storyboard.TargetName="SetupRoot"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            From="#4DA3FF"
                                                            To="#86C1FF"
                                                            Duration="0:0:0.8"/>
                                            <DoubleAnimation Storyboard.TargetName="SetupRoot"
                                                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                             From="0.34"
                                                             To="0.5"
                                                             Duration="0:0:0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SetupBluePulseStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SetupRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiveSetupConnectObsButtonStyle" TargetType="Button" BasedOn="{StaticResource LiveSetupBlinkButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnectObsSetupCompleted}" Value="True">
                    <Setter Property="Tag" Value="Completed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnectObsSetupTarget}" Value="True">
                    <Setter Property="Tag" Value="Pending"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveSetupStartOverlayButtonStyle" TargetType="Button" BasedOn="{StaticResource LiveSetupBlinkButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStartOverlaySetupCompleted}" Value="True">
                    <Setter Property="Tag" Value="Completed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStartOverlaySetupTarget}" Value="True">
                    <Setter Property="Tag" Value="Pending"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveSetupShowOverlayButtonStyle" TargetType="Button" BasedOn="{StaticResource LiveSetupBlinkButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShowOverlaySetupCompleted}" Value="True">
                    <Setter Property="Tag" Value="Completed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsShowOverlaySetupTarget}" Value="True">
                    <Setter Property="Tag" Value="Pending"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveSetupSelectChatRegionButtonStyle" TargetType="Button" BasedOn="{StaticResource LiveSetupBlinkButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectChatRegionSetupCompleted}" Value="True">
                    <Setter Property="Tag" Value="Completed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelectChatRegionSetupTarget}" Value="True">
                    <Setter Property="Tag" Value="Pending"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveSetupStartOcrButtonStyle" TargetType="Button" BasedOn="{StaticResource LiveSetupBlinkButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStartOcrSetupCompleted}" Value="True">
                    <Setter Property="Tag" Value="Completed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStartOcrSetupTarget}" Value="True">
                    <Setter Property="Tag" Value="Pending"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveProAiEnergyWrapStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#283547"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLiveProgramOutputLive}" Value="True">
                    <Setter Property="BorderBrush" Value="#52A8CC"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.32" Color="#5CB9E8"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLiveAiEnergyPulseForChrome}" Value="True">
                    <Setter Property="BorderBrush" Value="#4FA3C9"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.22" Color="#5CB9E8"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveProAiPanelStyle" TargetType="Border" BasedOn="{StaticResource LiveProSurfaceStyle}">
            <Setter Property="Padding" Value="16,14"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLiveProgramOutputLive}" Value="True">
                    <Setter Property="BorderBrush" Value="#4FA3C9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLiveAiEnergyPulseForChrome}" Value="True">
                    <Setter Property="BorderBrush" Value="#4FA3C9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveProCommentRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#111823"/>
            <Setter Property="BorderBrush" Value="#243549"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLatestInbound}" Value="True">
                    <Setter Property="BorderThickness" Value="3,1,1,1"/>
                    <Setter Property="BorderBrush" Value="#3D8FA8"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.2" Color="#67D4EA"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAiHandled}" Value="True">
                    <Setter Property="Opacity" Value="0.58"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LiveStudioProgramMeterStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="#5CB9E8"/>
            <Setter Property="Background" Value="#121B29"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#090D14" Foreground="#FFFFFF" BorderBrush="#2E3F57" BorderThickness="1">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Background" Value="#090D14"/>
                    <Setter Property="BorderBrush" Value="#2E3F57"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding" Value="10,4"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#142238"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Background" Value="#2E3F57"/>
                    <Setter Property="Margin" Value="6,2"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="Bảng giá nhanh" Click="MenuPriceCatalog_Click"/>
                <Separator/>
                <MenuItem Header="Lưu cài đặt" Click="MenuSave_Click"/>
                <MenuItem Header="Reset mặc định" Click="MenuReset_Click"/>
                <Separator/>
                <MenuItem Header="Thoát" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Trợ giúp">
                <MenuItem Header="Thông tin Titan AI Live PC" Click="MenuHelpInfo_Click"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Grid.RowSpan="3"
              Visibility="{Binding IsEngineerMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ModuleCardStyle}" Margin="0,0,0,8" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TITAN AI LIVE SYSTEM" Foreground="#F5C542" FontSize="19" FontWeight="Bold"/>
                    <ItemsControl ItemsSource="{Binding WaveformBars}" Height="18" Margin="10,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsLiveBroadcastEffectsEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="2" Height="{Binding}" Margin="1,0" Background="#4E7CB8" VerticalAlignment="Bottom" CornerRadius="2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <primitives:ToggleButton
                        Content="{Binding LiveBadgeText}"
                        IsChecked="{Binding IsLiveStreaming, Mode=OneWay}"
                        Command="{Binding ToggleLiveCommand}"
                        Background="{Binding LiveBadgeBackgroundBrush}"
                        BorderBrush="{Binding LiveBadgeBorderBrush}"
                        Style="{StaticResource InteractiveStatusToggleStyle}"/>
                    <primitives:ToggleButton
                        Content="{Binding ObsBadgeText}"
                        IsChecked="{Binding IsObsConnected, Mode=OneWay}"
                        Command="{Binding ReconnectObsCommand}"
                        ToolTip="{Binding ObsStatus}"
                        Background="{Binding ObsBadgeBackgroundBrush}"
                        BorderBrush="{Binding ObsBadgeBorderBrush}"
                        Style="{StaticResource InteractiveStatusToggleStyle}"/>
                    <primitives:ToggleButton
                        Content="{Binding AiBadgeText}"
                        IsChecked="{Binding IsAiEngineEnabled, Mode=OneWay}"
                        Command="{Binding ToggleAiEngineCommand}"
                        Background="{Binding AiBadgeBackgroundBrush}"
                        BorderBrush="{Binding AiBadgeBorderBrush}"
                        Style="{StaticResource InteractiveStatusToggleStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18*"/>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="20*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,7,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource ModuleCardStyle}" Margin="0,0,0,6"
                        Visibility="{Binding IsEngineerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="AI ENGINE" Style="{StaticResource ModuleTitleStyle}"/>
                        <PasswordBox x:Name="ApiKeyPasswordBox" PasswordChanged="ApiKeyPasswordBox_PasswordChanged" Height="28" Style="{StaticResource DarkPasswordBoxStyle}"/>
                        <UniformGrid Columns="3" Margin="0,5,0,0">
                            <controls:DspKnobControl Value="{Binding AiSensitivity}" Minimum="0" Maximum="100" Label="SENS" AccentColor="#4FA3FF"/>
                            <controls:DspKnobControl Value="{Binding ReplySpeed}" Minimum="0" Maximum="100" Label="AI SPD" AccentColor="#4FA3FF"/>
                            <controls:DspKnobControl Value="{Binding OverlayOpacity}" Minimum="0" Maximum="100" Label="OVL OP" AccentColor="#F5C542"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource ModuleCardStyle}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="OBS CONTROL" Style="{StaticResource ModuleTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ObsHost, UpdateSourceTrigger=PropertyChanged}" Height="26" Style="{StaticResource DarkTextBoxStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding ObsPort, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="5,0,0,0" Style="{StaticResource DarkTextBoxStyle}"/>
                        </Grid>
                        <PasswordBox x:Name="ObsPasswordBox" PasswordChanged="ObsPasswordBox_PasswordChanged" Height="26" Margin="0,5,0,0" Style="{StaticResource DarkPasswordBoxStyle}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="CONNECT OBS" Command="{Binding ConnectObsCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="0"/>
                            <Button Grid.Column="1" Content="DISCONNECT" Command="{Binding DisconnectObsCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="5,0,0,0"/>
                        </Grid>
                        <Border Visibility="{Binding IsEngineerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding ObsScenes}" SelectedItem="{Binding SelectedObsScene}" Height="26"/>
                                    <Button Grid.Column="1" Content="REFRESH" Command="{Binding RefreshObsScenesCommand}" Style="{StaticResource HardwareButtonStyle}" Width="78" Height="26" Margin="5,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding ObsSources}" SelectedItem="{Binding SelectedObsSource}" Height="26"/>
                                    <Button Grid.Column="1" Content="LOAD SRC" Command="{Binding RefreshObsSourcesCommand}" Style="{StaticResource HardwareButtonStyle}" Width="78" Height="26" Margin="5,0,0,0"/>
                                </Grid>
                                <Button Content="SWITCH SCENE" Command="{Binding SwitchObsSceneCommand}" Style="{StaticResource HardwareButtonStyle}" />
                                <TextBox Text="{Binding ObsOverlaySourceName, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,4,0,0" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Overlay source name"/>
                                <TextBox Text="{Binding OverlayBrandName, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,4,0,0" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Tên thương hiệu/sản phẩm hiển thị trên overlay"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="SHOW OVERLAY" Command="{Binding ShowOverlaySourceCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="0"/>
                            <Button Grid.Column="1" Content="HIDE OVERLAY" Command="{Binding HideOverlaySourceCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="5,0,0,0"/>
                        </Grid>
                        <TextBox Text="{Binding ObsTextSourceName, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,4,0,0" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Text source name"
                                 Visibility="{Binding IsEngineerMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="PUSH AI REPLY TO OBS TEXT" Command="{Binding PushReplyToObsTextCommand}" Style="{StaticResource HardwareButtonStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource ModuleCardStyle}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="OCR CHAT CAPTURE" Style="{StaticResource ModuleTitleStyle}"/>
                        <Button Content="SELECT CHAT REGION" Command="{Binding SelectChatRegionCommand}" Style="{StaticResource HardwareButtonStyle}"/>
                        <Grid Margin="0,4,0,0" Visibility="{Binding IsEngineerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="CHECK OCR SETUP" Command="{Binding CheckOcrSetupCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="0"/>
                            <Button Grid.Column="1" Content="OPEN TESSDATA FOLDER" Command="{Binding OpenTessdataFolderCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="5,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                            <Button Content="START" Command="{Binding StartOcrCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="0"/>
                            <Button Grid.Column="1" Content="STOP" Command="{Binding StopOcrCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="5,0,0,0"/>
                            <Border Grid.Column="2" Margin="5,0,0,0" Visibility="{Binding IsEngineerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBox Text="{Binding OcrCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Height="26" ToolTip="Cooldown seconds"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,4,0,0" Visibility="{Binding IsEngineerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <TextBlock Text="OCR CONFIDENCE THRESHOLD" Foreground="#8FB0D5" FontSize="9.5" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding OcrConfidenceThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Height="24" Margin="5,0,0,0"/>
                        </Grid>
                        <CheckBox Content="AUTO REPLY" IsChecked="{Binding AutoReplyEnabled}" Foreground="#C8D2E3" FontSize="10.5" Margin="0,5,0,0"/>
                        <CheckBox Content="AUTO TTS" IsChecked="{Binding AutoTtsEnabled}" Foreground="#C8D2E3" FontSize="10.5" Margin="0,2,0,0"/>
                        <CheckBox Content="AUTO SPEAK LIVE REPLY" IsChecked="{Binding AutoSpeakLiveReply}" Foreground="#9FE6B1" FontSize="10.5" Margin="0,2,0,0"/>
                        <StackPanel Visibility="{Binding IsEngineerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding OcrSetupStatus}" Foreground="#F5C542" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="BLACKLIST (comma separated)" Foreground="#8FB0D5" FontSize="9.5" Margin="0,4,0,2"/>
                            <TextBox Text="{Binding BlacklistInput, UpdateSourceTrigger=PropertyChanged}" Height="44" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource DarkTextBoxStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OcrStatus}" Foreground="#9FE6B1" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LastDetectedComment, StringFormat=Last: {0}}" Foreground="#9AB5D7" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="3" Style="{StaticResource ModuleCardStyle}">
                    <StackPanel>
                        <TextBlock Text="VOICE SYSTEM" Style="{StaticResource ModuleTitleStyle}"/>
                        <Border Visibility="{Binding IsEngineerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <UniformGrid Columns="2" Margin="0,2,0,0">
                                    <controls:DspKnobControl Value="{Binding VoiceDepth}" Minimum="0" Maximum="100" Label="DEPTH" AccentColor="#4FA3FF"/>
                                    <controls:DspKnobControl Value="{Binding TtsGain}" Minimum="0" Maximum="100" Label="TTS GAIN" AccentColor="#F5C542"/>
                                </UniformGrid>
                                <TextBlock Text="VOICE STYLE PRESET" Foreground="#8FB0D5" FontSize="9.5" Margin="0,5,0,2"/>
                                <ComboBox ItemsSource="{Binding VoiceStylePresetOptions}" SelectedItem="{Binding SelectedVoiceStylePreset}" Height="26"/>
                                <CheckBox Content="AUTO PRESET BY REPLY TYPE" IsChecked="{Binding AutoVoiceStylePreset}" Foreground="#C8D2E3" FontSize="10.5" Margin="0,4,0,0"/>
                                <CheckBox Content="MANUAL APPROVE MODE" IsChecked="{Binding IsManualApproveMode}" Foreground="#F5C542" FontSize="10.5" Margin="0,2,0,0"/>
                                <CheckBox Content="BEEP ON PENDING" IsChecked="{Binding BeepOnPending}" Foreground="#C8D2E3" FontSize="10.5" Margin="0,2,0,0"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding CurrentVoicePresetBadgeBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentVoicePresetStatusText}" Foreground="#D9E2F0" FontSize="9.8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Slider Minimum="0.5" Maximum="1.8" Value="{Binding VoiceSpeed}" TickFrequency="0.1" IsSnapToTickEnabled="False" Height="20"/>
                                    <TextBlock Grid.Column="1" Text="{Binding VoiceSpeed, StringFormat=SPD {0:F2}x}" Foreground="#9AB5D7" FontSize="9.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Slider Minimum="0.5" Maximum="1.8" Value="{Binding VoicePitch}" TickFrequency="0.1" IsSnapToTickEnabled="False" Height="20"/>
                                    <TextBlock Grid.Column="1" Text="{Binding VoicePitch, StringFormat=PITCH {0:F2}x}" Foreground="#9AB5D7" FontSize="9.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="PREVIEW VOICE" Command="{Binding PreviewVoiceCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="0"/>
                                    <Button Grid.Column="1" Content="TEST EDGE VIETNAMESE" Command="{Binding TestEdgeVietnameseCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="5,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="VOICE" Foreground="#8FB0D5" FontSize="9.5" Margin="0,5,0,2"/>
                        <ComboBox ItemsSource="{Binding VoiceOptions}" SelectedItem="{Binding SelectedVoiceName}" Height="26"/>
                        <Button Content="SPEAK REPLY" Command="{Binding SpeakReplyCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="0,6,0,0"/>
                        <CheckBox Content="MUTE" IsChecked="{Binding IsMuted}" Foreground="#C8D2E3" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="7,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.18*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource ModuleCardStyle}" Margin="0,0,0,7">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="LIVE FEED" Style="{StaticResource ModuleTitleStyle}"/>
                        <TextBox Grid.Row="1" Text="{Binding CommentInput, UpdateSourceTrigger=PropertyChanged}" Height="36" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource DarkTextBoxStyle}"/>
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="ADD COMMENT" Command="{Binding AddCommentCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="0"/>
                            <Button Grid.Column="1" Content="GEN AI REPLY" Command="{Binding GenerateReplyCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="5,0,0,0"/>
                            <Grid Grid.Column="2" Margin="7,0,0,0">
                                <Border Background="#0B1017" BorderBrush="#2D3F58" BorderThickness="1" CornerRadius="6"/>
                                <ItemsControl ItemsSource="{Binding PlaceholderComments}" IsHitTestVisible="False" Opacity="0.28" Margin="8,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Foreground="#5C7FAE" FontSize="10" Margin="0,0,0,2"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ListView ItemsSource="{Binding Comments}" Background="Transparent" BorderThickness="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#182130" BorderBrush="#30445F" BorderThickness="1" CornerRadius="6" Padding="5" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding UserName}" Foreground="#F5C542" FontSize="10.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CommentText}" Foreground="#E6E9EF" FontSize="10.5" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ConfidenceScore, StringFormat=Confidence: {0}%}" Foreground="#8FD2FF" FontSize="9.5" Margin="0,2,0,0"
                                                               Visibility="{Binding DataContext.IsEngineerMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.38*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ModuleCardStyle}" Margin="0,0,7,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="AI RESPONSE" Style="{StaticResource ModuleTitleStyle}"/>
                            <TextBlock Grid.Row="1" Text="{Binding LatestCommentPreview}" Foreground="#A8C1E3" FontSize="10.5"/>
                            <TextBox Grid.Row="2" Text="{Binding CurrentReply}" IsReadOnly="True" Margin="0,6,0,0" Style="{StaticResource DarkTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource ModuleCardStyle}" Margin="0,0,0,7">
                            <StackPanel>
                                <TextBlock Text="OVERLAY ENGINE" Style="{StaticResource ModuleTitleStyle}"/>
                                <TextBlock Text="{Binding OverlayStatus}" Foreground="#D0D7E5" FontSize="10.5" TextWrapping="Wrap"/>
                                <Button Content="START OVERLAY" Command="{Binding StartOverlayServerCommand}" Style="{StaticResource HardwareButtonStyle}" Margin="0,6,0,0"/>
                                <Button Content="STOP OVERLAY" Command="{Binding StopOverlayServerCommand}" Style="{StaticResource HardwareButtonStyle}"/>
