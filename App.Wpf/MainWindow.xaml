                        </Border>
                        <TextBlock Text="{Binding ObsStatus}" Foreground="#DCE4F2" FontSize="10.5"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="3" Style="{StaticResource PendingApprovalPanelStyle}" Margin="0,0,0,6"
