<Window x:Class="TitanAILivePC.Views.RemoteCameraQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Titan WebCam Pairing"
        Width="560"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0E1218"
        Foreground="#E7EDF7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="TITAN WEBCAM PAIRING"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#9FE6B1"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding RoomCode, StringFormat=ROOM CODE: {0}}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,8,0,8"
                   Foreground="#F5C542"/>

        <Border Grid.Row="2"
                Background="#131B25"
                BorderBrush="#2E3F56"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
            <StackPanel>
                <TextBlock Text="SCAN THIS QR WITH TITAN WEBCAM"
                           Foreground="#8FB0D5"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <Border Margin="0,8,0,0"
                        Background="#FFFFFF"
                        BorderBrush="#314863"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        HorizontalAlignment="Center">
                    <Grid>
                        <Image x:Name="QrImageControl"
                               Width="300"
                               Height="300"
                               Stretch="Uniform"/>
                        <TextBlock x:Name="QrFallbackText"
                                   Text="QR not available"
                                   Foreground="#1B2A3B"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding PairingUrl, StringFormat=Pairing URL: {0}}"
                           Margin="0,10,0,0"
                           Foreground="#9FC2E8"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="COPY LINK"
                    Height="34"
                    Margin="0,0,6,0"
                    Click="CopyLink_Click"/>
            <Button Grid.Column="1"
                    Content="CLOSE"
                    Height="34"
                    Margin="6,0,0,0"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
